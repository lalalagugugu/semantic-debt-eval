      "additions": [
        {
          "interpretation": "遵守企业约定及题干限定口径；购买事件=SalesQuantity>0",
          "sql": "WITH baskets AS (\nSELECT f.SalesOrderNumber,groupUniqArrayIf(f.ProductKey,p.BrandName='Contoso' AND f.SalesQuantity>0) AS products\nFROM retail.FactOnlineSales f LEFT JOIN retail.DimProduct p ON f.ProductKey=p.ProductKey\nWHERE toYear(f.DateKey)=2009 GROUP BY f.SalesOrderNumber),\nfirst_product AS (SELECT SalesOrderNumber,products,arrayJoin(products) AS product1_key FROM baskets),\npairs AS (SELECT product1_key,product2_key,count() AS both_orders FROM first_product ARRAY JOIN products AS product2_key\nWHERE product1_key<product2_key GROUP BY product1_key,product2_key),\nmarginal AS (SELECT product1_key AS ProductKey,count() AS product_orders FROM first_product GROUP BY product1_key),\ntotal AS (SELECT count() AS all_orders FROM baskets)\nSELECT a.ProductKey AS product1_key,b.ProductKey AS product2_key,\nifNull(x.both_orders,0)*1.0/t.all_orders AS support_ratio,\nifNull(x.both_orders,0)*1.0/a.product_orders AS confidence_1_to_2_ratio,\nifNull(x.both_orders,0)*1.0/b.product_orders AS confidence_2_to_1_ratio,\nifNull(x.both_orders,0)*1.0*t.all_orders/(a.product_orders*b.product_orders) AS lift_ratio\nFROM marginal a CROSS JOIN marginal b CROSS JOIN total t LEFT JOIN pairs x ON a.ProductKey=x.product1_key AND b.ProductKey=x.product2_key\nWHERE a.ProductKey<b.ProductKey",
          "result_path": "refs/new/Q122-2.csv",

          "interpretation": "原参考解读；购买事件=SalesQuantity>0",
          "sql": "WITH max_date AS (SELECT MAX(DateKey) as data_end FROM (SELECT * FROM retail.FactOnlineSales WHERE SalesQuantity>0)), customer_last AS (SELECT CustomerKey, MAX(DateKey) as last_purchase FROM (SELECT * FROM retail.FactOnlineSales WHERE SalesQuantity>0) GROUP BY CustomerKey) SELECT CASE WHEN dateDiff('month', cl.last_purchase, md.data_end) <= 6 THEN 'Active' WHEN dateDiff('month', cl.last_purchase, md.data_end) <= 12 THEN 'At Risk' ELSE 'Churned' END as segment, count() as customers FROM customer_last cl, max_date md GROUP BY segment",

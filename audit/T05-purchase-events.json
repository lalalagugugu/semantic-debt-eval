          "all_rows_signature": "078a98a430542394bc8c622cbbaf3a0f995e31364ef95cb8cc3f61b2cb8c8127",
          "positive_sales_signature": "051203a97266e501997ecebbdfa446fe6faf4217672f5798fb7b9eac8b66d4ff",
          "positive_sql_sha256": "2784a1ed6274819d8259a072803abf4e120c580b1f630ad2c1de898e6a1b3dd0",
          "positive_maps_to": "refs/cube/Q89-2.csv",
          "new_reference": true
        }
      ],
      "additions": [
        {
          "interpretation": "原参考解读；购买事件=SalesQuantity>0",
          "sql": "WITH cust_recency AS (\n  SELECT CustomerKey,\n         maxIf(DateKey,SalesQuantity>0) AS last_purchase,\n         SUM(SalesAmount) AS total_spend,\n         countDistinctIf(ProductKey,SalesQuantity>0) AS distinct_products\n  FROM retail.FactOnlineSales\n  GROUP BY CustomerKey HAVING countIf(SalesQuantity>0)>0\n),\nsegmented AS (\n  SELECT *,\n         dateDiff('month', last_purchase, toDate('2009-12-31')) AS months_inactive,\n         CASE\n           WHEN dateDiff('month', last_purchase, toDate('2009-12-31')) <= 6 THEN 'Active'\n           WHEN dateDiff('month', last_purchase, toDate('2009-12-31')) <= 12 THEN 'At Risk'\n           ELSE 'Churned'\n         END AS segment\n  FROM cust_recency\n)\nSELECT segment,\n       count() AS customers,\n       round(avg(total_spend), 2) AS avg_spend,\n       round(avg(distinct_products), 1) AS avg_distinct_products\nFROM segmented\nGROUP BY segment\nORDER BY CASE segment WHEN 'Active' THEN 1 WHEN 'At Risk' THEN 2 ELSE 3 END",
          "result_path": "refs/cube/Q89-2.csv",
          "rules": {
            "ordered": false,
            "top_n": null,
            "tie_columns": [],
            "value_kinds": [
              "other",
              "count",
              "amount",
              "other"
            ],

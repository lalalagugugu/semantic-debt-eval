  "sql": "SELECT\n    g.RegionCountryName AS country,\n    avg(dateDiff('day', customer_stats.first_purchase_date, customer_stats.last_purchase_date)) AS avg_days_between_first_and_most_recent_purchase\nFROM\n(\n    SELECT\n        fos.CustomerKey,\n        min(fos.DateKey) AS first_purchase_date,\n        max(fos.DateKey) AS last_purchase_date\n    FROM retail.FactOnlineSales AS fos\n    GROUP BY fos.CustomerKey\n) AS customer_stats\nINNER JOIN retail.DimCustomer AS c\n    ON customer_stats.CustomerKey = c.CustomerKey\nINNER JOIN retail.DimGeography AS g\n    ON c.GeographyKey = g.GeographyKey\nGROUP BY g.RegionCountryName\nORDER BY avg_days_between_first_and_most_recent_purchase DESC",

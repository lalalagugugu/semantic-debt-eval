{
  "question_id": 97,
  "model": "gpt-5.4",
  "variant": "semantic",
  "sql": "SELECT\n    p.ProductKey,\n    p.ProductName,\n    sumIf(fos.SalesAmount, fos.DateKey >= toDate('2009-01-01') AND fos.DateKey < toDate('2009-07-01')) AS h1_sales,\n    sumIf(fos.SalesAmount, fos.DateKey >= toDate('2009-07-01') AND fos.DateKey <= toDate('2009-12-31')) AS h2_sales,\n    h2_sales - h1_sales AS comeback_amount,\n    (h2_sales - h1_sales) * 100.0 / nullIf(h1_sales, 0) AS comeback_pct\nFROM retail.FactOnlineSales AS fos\nINNER JOIN retail.DimProduct AS p\n    ON fos.ProductKey = p.ProductKey\nWHERE fos.DateKey >= toDate('2009-01-01')\n  AND fos.DateKey <= toDate('2009-12-31')\nGROUP BY\n    p.ProductKey,\n    p.ProductName\nHAVING h2_sales > h1_sales\nORDER BY comeback_amount DESC, comeback_pct DESC, p.ProductKey ASC",

  "sql": "WITH category_year_margin AS (\n    SELECT\n        d.CalendarYear AS calendar_year,\n        pc.ProductCategoryName AS product_category,\n        (sum(os.SalesAmount) - sum(os.TotalCost)) * 100.0 / nullif(sum(os.SalesAmount), 0) AS gross_margin_pct\n    FROM retail.FactOnlineSales AS os\n    INNER JOIN retail.DimDate AS d\n        ON os.DateKey = d.DateKey\n    INNER JOIN retail.DimProduct AS p\n        ON os.ProductKey = p.ProductKey\n    INNER JOIN retail.DimProductSubcategory AS ps\n        ON toInt32(p.ProductSubcategoryKey) = ps.ProductSubcategoryKey\n    INNER JOIN retail.DimProductCategory AS pc\n        ON ps.ProductCategoryKey = pc.ProductCategoryKey\n    WHERE d.CalendarYear IN (2007, 2008, 2009)\n    GROUP BY\n        d.CalendarYear,\n        pc.ProductCategoryName\n)\nSELECT\n    product_category,\n    calendar_year,\n    gross_margin_pct,\n    gross_margin_pct - lagInFrame(gross_margin_pct) OVER (\n        PARTITION BY product_category\n        ORDER BY calendar_year\n        ROWS BETWEEN 1 PRECEDING AND CURRENT ROW\n    ) AS yoy_change_pct_points\nFROM category_year_margin\nORDER BY\n    product_category,\n    calendar_year",

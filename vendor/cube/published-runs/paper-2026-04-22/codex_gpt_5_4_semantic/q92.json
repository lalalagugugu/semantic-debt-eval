  "sql": "SELECT\n    p.BrandName AS brand_name,\n    sum(f.SalesAmount) - sum(f.TotalCost) AS gross_margin_amount,\n    (sum(f.SalesAmount) - sum(f.TotalCost)) / nullif(sum(f.SalesAmount), 0) AS gross_margin_pct\nFROM retail.FactOnlineSales AS f\nINNER JOIN retail.DimProduct AS p\n    ON f.ProductKey = p.ProductKey\nWHERE f.DateKey >= toDate('2009-10-01')\n  AND f.DateKey <= toDate('2009-12-31')\n  AND p.BrandName IS NOT NULL\n  AND p.BrandName != ''\nGROUP BY p.BrandName\nORDER BY gross_margin_amount DESC, brand_name ASC",

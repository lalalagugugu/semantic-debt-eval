  "sql": "SELECT\n    d.CalendarMonthLabel AS month,\n    d.MonthNumber AS month_number,\n    sum(f.SalesAmount) - sum(f.TotalCost) AS gross_margin_dollars,\n    (sum(f.SalesAmount) - sum(f.TotalCost)) / nullif(sum(f.SalesAmount), 0) AS gross_margin_percent\nFROM retail.FactOnlineSales AS f\nINNER JOIN retail.DimDate AS d\n    ON f.DateKey = d.DateKey\nWHERE d.CalendarYear = 2009\nGROUP BY\n    d.CalendarMonthLabel,\n    d.MonthNumber\nORDER BY d.MonthNumber",

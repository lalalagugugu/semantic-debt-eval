  "variant": "semantic",
  "sql": "SELECT\n    c.CustomerKey,\n    c.FirstName,\n    c.LastName,\n    dateDiff('month', lp.last_purchase_date, toDate('2009-12-31')) AS months_since_last_purchase,\n    multiIf(\n        dateDiff('month', lp.last_purchase_date, toDate('2009-12-31')) <= 6, 'Active',\n        dateDiff('month', lp.last_purchase_date, toDate('2009-12-31')) <= 12, 'At Risk',\n        'Churned'\n    ) AS recency_segment\nFROM retail.DimCustomer AS c\nINNER JOIN\n(\n    SELECT\n        CustomerKey,\n        MAX(DateKey) AS last_purchase_date\n    FROM retail.FactOnlineSales\n    GROUP BY CustomerKey\n) AS lp\n    ON c.CustomerKey = lp.CustomerKey\nORDER BY c.CustomerKey",

  "variant": "semantic",
  "sql": "SELECT\n    ps.ProductSubcategoryKey,\n    ps.ProductSubcategoryName,\n    sum(fos.SalesAmount) AS total_online_sales\nFROM retail.FactOnlineSales AS fos\nINNER JOIN retail.DimDate AS d\n    ON fos.DateKey = d.DateKey\nINNER JOIN retail.DimProduct AS p\n    ON fos.ProductKey = p.ProductKey\nINNER JOIN retail.DimProductSubcategory AS ps\n    ON toInt32(p.ProductSubcategoryKey) = ps.ProductSubcategoryKey\nWHERE d.CalendarYear = 2009\nGROUP BY\n    ps.ProductSubcategoryKey,\n    ps.ProductSubcategoryName\nHAVING sum(fos.SalesAmount) > 1000000\nORDER BY total_online_sales DESC",

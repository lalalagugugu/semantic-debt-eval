  "sql": "WITH monthly_sales AS (\n    SELECT\n        toStartOfMonth(DateKey) AS month_start,\n        sum(SalesAmount) AS monthly_sales\n    FROM retail.FactOnlineSales\n    WHERE toYear(DateKey) = 2009\n    GROUP BY month_start\n)\nSELECT\n    month_start,\n    monthly_sales,\n    (monthly_sales - lagInFrame(monthly_sales) OVER (ORDER BY month_start)) * 100.0\n        / nullIf(lagInFrame(monthly_sales) OVER (ORDER BY month_start), 0) AS mom_growth_rate_pct\nFROM monthly_sales\nORDER BY month_start;",

  "sql": "SELECT\n    p.BrandName AS brand_name,\n    sum(s.SalesAmount) AS total_online_revenue,\n    sum(s.SalesQuantity) AS units_sold\nFROM retail.FactOnlineSales AS s\nINNER JOIN retail.DimProduct AS p\n    ON s.ProductKey = p.ProductKey\nWHERE toYear(s.DateKey) = 2008\nGROUP BY p.BrandName\nHAVING sum(s.SalesQuantity) >= 500\nORDER BY total_online_revenue DESC",

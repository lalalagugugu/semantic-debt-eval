  "sql": "SELECT\n    ps.ProductSubcategoryName,\n    corrStable(toFloat64(pr.DiscountPercent), toFloat64(fos.SalesQuantity)) AS discount_sales_quantity_correlation\nFROM retail.FactOnlineSales AS fos\nINNER JOIN retail.DimPromotion AS pr\n    ON fos.PromotionKey = pr.PromotionKey\nINNER JOIN retail.DimProduct AS p\n    ON fos.ProductKey = p.ProductKey\nINNER JOIN retail.DimProductSubcategory AS ps\n    ON toInt32(p.ProductSubcategoryKey) = ps.ProductSubcategoryKey\nWHERE toYear(fos.DateKey) = 2009\n  AND fos.PromotionKey != 1\n  AND pr.DiscountPercent IS NOT NULL\nGROUP BY ps.ProductSubcategoryName\nORDER BY ps.ProductSubcategoryName",

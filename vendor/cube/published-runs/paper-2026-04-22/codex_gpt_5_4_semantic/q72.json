  "sql": "SELECT\n    quarter_start,\n    toYear(quarter_start) AS calendar_year,\n    concat('Q', toString(toQuarter(quarter_start))) AS calendar_quarter,\n    quarterly_sales,\n    sum(quarterly_sales) OVER (ORDER BY quarter_start ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_cumulative_sales\nFROM\n(\n    SELECT\n        toStartOfQuarter(DateKey) AS quarter_start,\n        sum(SalesAmount) AS quarterly_sales\n    FROM retail.FactOnlineSales\n    WHERE DateKey >= toDate('2007-01-01')\n      AND DateKey < toDate('2010-01-01')\n    GROUP BY quarter_start\n)\nORDER BY quarter_start;",

  "variant": "semantic",
  "sql": "SELECT\n    s.CustomerKey,\n    c.FirstName,\n    c.LastName,\n    sumIf(s.SalesAmount, toYear(s.DateKey) = 2008) AS sales_2008,\n    sumIf(s.SalesAmount, toYear(s.DateKey) = 2009) AS sales_2009,\n    (sumIf(s.SalesAmount, toYear(s.DateKey) = 2009) - sumIf(s.SalesAmount, toYear(s.DateKey) = 2008)) * 100.0\n        / nullIf(sumIf(s.SalesAmount, toYear(s.DateKey) = 2008), 0) AS spending_growth_pct\nFROM retail.FactOnlineSales AS s\nINNER JOIN retail.DimCustomer AS c\n    ON s.CustomerKey = c.CustomerKey\nWHERE toYear(s.DateKey) IN (2008, 2009)\nGROUP BY\n    s.CustomerKey,\n    c.FirstName,\n    c.LastName\nHAVING\n    sumIf(s.SalesAmount, toYear(s.DateKey) = 2008) > 0\n    AND sumIf(s.SalesAmount, toYear(s.DateKey) = 2009) > sumIf(s.SalesAmount, toYear(s.DateKey) = 2008) * 1.5\nORDER BY spending_growth_pct DESC",

  "sql": "SELECT\n    s.StoreKey,\n    s.StoreName,\n    round(sum(fs.SalesAmount) / nullIf(s.SellingAreaSize, 0), 2) AS sales_per_square_foot\nFROM retail.FactSales AS fs\nINNER JOIN retail.DimStore AS s\n    ON fs.StoreKey = s.StoreKey\nWHERE s.SellingAreaSize IS NOT NULL\n  AND s.SellingAreaSize > 0\nGROUP BY\n    s.StoreKey,\n    s.StoreName,\n    s.SellingAreaSize\nORDER BY sales_per_square_foot DESC",

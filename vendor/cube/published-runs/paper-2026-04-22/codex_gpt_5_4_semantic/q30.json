  "sql": "SELECT\n    DateKey,\n    daily_online_sales,\n    avg(daily_online_sales) OVER (\n        ORDER BY DateKey\n        ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n    ) AS moving_avg_7d\nFROM\n(\n    SELECT\n        DateKey,\n        sum(SalesAmount) AS daily_online_sales\n    FROM retail.FactOnlineSales\n    WHERE DateKey >= toDate('2009-12-01')\n      AND DateKey <= toDate('2009-12-31')\n    GROUP BY DateKey\n)\nORDER BY DateKey",

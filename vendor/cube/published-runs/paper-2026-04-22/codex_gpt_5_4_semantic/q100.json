  "variant": "semantic",
  "sql": "WITH customer_metrics AS (\n    SELECT\n        fos.CustomerKey,\n        countDistinct(fos.SalesOrderNumber) AS order_count,\n        sum(fos.SalesAmount) / nullif(countDistinct(fos.SalesOrderNumber), 0) AS avg_order_size\n    FROM retail.FactOnlineSales AS fos\n    GROUP BY fos.CustomerKey\n),\nthresholds AS (\n    SELECT\n        quantileExact(0.9)(order_count) AS order_count_p90,\n        quantileExact(0.9)(avg_order_size) AS avg_order_size_p90\n    FROM customer_metrics\n)\nSELECT\n    cm.CustomerKey,\n    dc.FirstName,\n    dc.LastName,\n    cm.order_count,\n    cm.avg_order_size\nFROM customer_metrics AS cm\nCROSS JOIN thresholds AS t\nINNER JOIN retail.DimCustomer AS dc\n    ON dc.CustomerKey = cm.CustomerKey\nWHERE cm.order_count >= t.order_count_p90\n  AND cm.avg_order_size >= t.avg_order_size_p90\nORDER BY cm.order_count DESC, cm.avg_order_size DESC, cm.CustomerKey ASC",

  "sql": "SELECT\n    s.StoreKey,\n    ds.StoreName,\n    s.sales_amount_2009,\n    q.quota_amount_2009,\n    s.sales_amount_2009 / nullIf(q.quota_amount_2009, 0) AS sales_to_quota_attainment\nFROM\n(\n    SELECT\n        StoreKey,\n        sum(SalesAmount) AS sales_amount_2009\n    FROM retail.FactSales\n    WHERE toYear(DateKey) = 2009\n    GROUP BY StoreKey\n) AS s\nINNER JOIN\n(\n    SELECT\n        StoreKey,\n        sum(SalesAmountQuota) AS quota_amount_2009\n    FROM retail.FactSalesQuota\n    WHERE toYear(DateKey) = 2009\n    GROUP BY StoreKey\n) AS q\n    ON s.StoreKey = q.StoreKey\nINNER JOIN retail.DimStore AS ds\n    ON s.StoreKey = ds.StoreKey\nORDER BY sales_to_quota_attainment DESC\nLIMIT 10",

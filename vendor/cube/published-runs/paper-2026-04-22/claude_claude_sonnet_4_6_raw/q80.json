  "sql": "SELECT\n    g.RegionCountryName,\n    avg(dateDiff('day', first_purchase, last_purchase)) AS avg_days_between_first_and_last_purchase\nFROM (\n    SELECT\n        CustomerKey,\n        min(DateKey) AS first_purchase,\n        max(DateKey) AS last_purchase\n    FROM retail.FactOnlineSales\n    GROUP BY CustomerKey\n) AS cp\nJOIN retail.DimCustomer AS c ON c.CustomerKey = cp.CustomerKey\nJOIN retail.DimGeography AS g ON g.GeographyKey = c.GeographyKey\nGROUP BY g.RegionCountryName\nORDER BY avg_days_between_first_and_last_purchase DESC",

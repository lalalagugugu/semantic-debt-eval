  "sql": "SELECT\n    p.ProductKey,\n    p.ProductName,\n    sum(s.SalesAmount) AS total_sales,\n    sum(s.TotalCost) AS total_cost,\n    round((sum(s.SalesAmount) - sum(s.TotalCost)) / sum(s.SalesAmount) * 100, 2) AS profit_margin_pct\nFROM retail.FactSales AS s\nINNER JOIN retail.DimProduct AS p ON s.ProductKey = p.ProductKey\nWHERE s.SalesAmount > 0\nGROUP BY p.ProductKey, p.ProductName\nORDER BY profit_margin_pct DESC\nLIMIT 10",

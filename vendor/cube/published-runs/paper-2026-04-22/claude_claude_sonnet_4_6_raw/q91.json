  "variant": "raw",
  "sql": "SELECT\n    dc.YearlyIncome,\n    count(DISTINCT fos.CustomerKey) AS CustomerCount,\n    round(sum(fos.SalesAmount), 2) AS TotalSalesAmount,\n    round(avg(fos.SalesAmount), 2) AS AvgSalesPerTransaction,\n    round(sum(fos.SalesAmount) / count(DISTINCT fos.CustomerKey), 2) AS AvgSalesPerCustomer,\n    round(sum(fos.SalesQuantity), 0) AS TotalUnitsPurchased\nFROM retail.FactOnlineSales AS fos\nJOIN retail.DimCustomer AS dc ON fos.CustomerKey = dc.CustomerKey\nWHERE dc.YearlyIncome IS NOT NULL\nGROUP BY dc.YearlyIncome\nORDER BY dc.YearlyIncome ASC",

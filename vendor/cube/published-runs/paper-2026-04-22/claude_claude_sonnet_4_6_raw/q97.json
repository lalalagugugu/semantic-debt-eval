  "sql": "SELECT\n    p.ProductName,\n    sumIf(fs.SalesAmount, toMonth(fs.DateKey) <= 6) AS h1_sales,\n    sumIf(fs.SalesAmount, toMonth(fs.DateKey) > 6)  AS h2_sales,\n    h2_sales - h1_sales                              AS comeback,\n    if(h1_sales > 0, round(h2_sales / h1_sales, 2), NULL) AS h2_to_h1_ratio\nFROM retail.FactSales AS fs\nJOIN retail.DimProduct AS p ON fs.ProductKey = p.ProductKey\nWHERE toYear(fs.DateKey) = 2009\nGROUP BY p.ProductName\nHAVING h2_sales > h1_sales\nORDER BY comeback DESC\nLIMIT 20",

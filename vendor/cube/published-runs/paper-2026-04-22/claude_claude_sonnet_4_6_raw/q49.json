  "variant": "raw",
  "sql": "SELECT\n    e.EntityKey,\n    e.EntityName,\n    e.EntityType,\n    e.ParentEntityKey,\n    e.ParentEntityLabel,\n    e.Status,\n    sum(fs.SalesAmount)   AS TotalSalesAmount,\n    sum(fs.SalesQuantity) AS TotalSalesQuantity,\n    sum(fs.TotalCost)     AS TotalCost,\n    sum(fs.SalesAmount) - sum(fs.TotalCost) AS GrossProfit,\n    count()               AS TransactionCount\nFROM retail.FactSales AS fs\nINNER JOIN retail.DimStore AS s\n    ON fs.StoreKey = s.StoreKey\nINNER JOIN retail.DimEntity AS e\n    ON toInt32(s.EntityKey) = e.EntityKey\nGROUP BY\n    e.EntityKey,\n    e.EntityName,\n    e.EntityType,\n    e.ParentEntityKey,\n    e.ParentEntityLabel,\n    e.Status\nORDER BY\n    e.ParentEntityKey NULLS FIRST,\n    TotalSalesAmount DESC",

  "sql": "SELECT\n    ds.StoreManager,\n    ds.StoreName,\n    sum(s.SalesAmount) AS TotalSales\nFROM retail.DimStore ds\nJOIN (\n    SELECT StoreKey, SalesAmount FROM retail.FactSales\n    UNION ALL\n    SELECT StoreKey, SalesAmount FROM retail.FactOnlineSales\n) s ON ds.StoreKey = s.StoreKey\nGROUP BY ds.StoreManager, ds.StoreName\nHAVING TotalSales > 5000000\nORDER BY TotalSales DESC",

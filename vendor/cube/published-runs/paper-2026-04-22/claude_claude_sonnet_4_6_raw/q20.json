  "variant": "raw",
  "sql": "SELECT\n    p.ProductKey,\n    p.ProductName,\n    p.BrandName,\n    latest.OnHandQuantity,\n    latest.SafetyStockQuantity,\n    latest.SafetyStockQuantity - latest.OnHandQuantity AS ShortfallQuantity,\n    latest.DateKey AS LatestDate\nFROM (\n    SELECT\n        ProductKey,\n        OnHandQuantity,\n        SafetyStockQuantity,\n        DateKey\n    FROM retail.FactInventory\n    WHERE (ProductKey, DateKey) IN (\n        SELECT ProductKey, max(DateKey)\n        FROM retail.FactInventory\n        GROUP BY ProductKey\n    )\n) AS latest\nJOIN retail.DimProduct AS p ON latest.ProductKey = p.ProductKey\nWHERE latest.OnHandQuantity < latest.SafetyStockQuantity\nORDER BY ShortfallQuantity DESC",

  "sql": "SELECT\n    s.StoreName,\n    p.ProductName,\n    sum(fi.OnHandQuantity) AS TotalOnHand,\n    sum(fi.OnOrderQuantity) AS TotalOnOrder,\n    sum(fi.SafetyStockQuantity) AS TotalSafetyStock\nFROM retail.FactInventory fi\nJOIN retail.DimStore s ON fi.StoreKey = s.StoreKey\nJOIN retail.DimProduct p ON fi.ProductKey = p.ProductKey\nWHERE fi.DateKey = (\n    SELECT max(DateKey) FROM retail.FactInventory\n)\nGROUP BY s.StoreName, p.ProductName\nORDER BY s.StoreName, p.ProductName",

  "sql": "SELECT\n    s.StoreKey,\n    s.StoreName,\n    s.SellingAreaSize,\n    sum(f.SalesAmount) AS TotalSales,\n    round(sum(f.SalesAmount) / s.SellingAreaSize, 2) AS SalesPerSquareFoot\nFROM retail.FactSales f\nJOIN retail.DimStore s ON f.StoreKey = s.StoreKey\nWHERE s.SellingAreaSize > 0\nGROUP BY s.StoreKey, s.StoreName, s.SellingAreaSize\nORDER BY SalesPerSquareFoot DESC",

  "sql": "SELECT\n    p.ColorName,\n    sum(o.SalesAmount) / sum(o.SalesQuantity) AS AvgUnitPriceRealized,\n    sum(o.SalesQuantity) AS TotalUnitsSold\nFROM retail.FactOnlineSales o\nJOIN retail.DimProduct p ON o.ProductKey = p.ProductKey\nWHERE p.ColorName IS NOT NULL\nGROUP BY p.ColorName\nHAVING TotalUnitsSold >= 1000\nORDER BY AvgUnitPriceRealized DESC",

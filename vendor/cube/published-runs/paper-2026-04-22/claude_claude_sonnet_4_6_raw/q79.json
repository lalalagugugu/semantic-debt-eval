  "variant": "raw",
  "sql": "SELECT\n    s.StoreKey,\n    st.StoreName,\n    sum(s.SalesAmount) AS TotalSales,\n    sum(q.SalesAmountQuota) AS TotalQuota,\n    sum(s.SalesAmount) / sum(q.SalesAmountQuota) AS Attainment\nFROM retail.FactSales s\nJOIN retail.DimStore st ON s.StoreKey = st.StoreKey\nJOIN (\n    SELECT StoreKey, sum(SalesAmountQuota) AS SalesAmountQuota\n    FROM retail.FactSalesQuota\n    WHERE toYear(DateKey) = 2009\n    GROUP BY StoreKey\n) q ON s.StoreKey = q.StoreKey\nWHERE toYear(s.DateKey) = 2009\nGROUP BY s.StoreKey, st.StoreName\nHAVING TotalQuota > 0\nORDER BY Attainment DESC\nLIMIT 10",

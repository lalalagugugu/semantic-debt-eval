  "sql": "SELECT\n    pc.ProductCategoryName,\n    year,\n    best_quarter,\n    round(max_quarter_sales / annual_sales * 100, 2) AS pct_from_best_quarter,\n    round(annual_sales, 2) AS annual_sales,\n    round(max_quarter_sales, 2) AS max_quarter_sales\nFROM (\n    SELECT\n        ProductCategoryKey,\n        year,\n        argMax(quarter, quarter_sales) AS best_quarter,\n        max(quarter_sales)             AS max_quarter_sales,\n        sum(quarter_sales)             AS annual_sales\n    FROM (\n        SELECT\n            ps.ProductCategoryKey,\n            toYear(fs.DateKey)    AS year,\n            toQuarter(fs.DateKey) AS quarter,\n            sum(fs.SalesAmount)   AS quarter_sales\n        FROM retail.FactSales AS fs\n        INNER JOIN retail.DimProduct            AS p  ON fs.ProductKey            = p.ProductKey\n        INNER JOIN retail.DimProductSubcategory AS ps ON toInt32(p.ProductSubcategoryKey) = ps.ProductSubcategoryKey\n        GROUP BY ps.ProductCategoryKey, year, quarter\n    )\n    GROUP BY ProductCategoryKey, year\n) AS q\nINNER JOIN retail.DimProductCategory AS pc ON q.ProductCategoryKey = pc.ProductCategoryKey\nORDER BY pct_from_best_quarter DESC",

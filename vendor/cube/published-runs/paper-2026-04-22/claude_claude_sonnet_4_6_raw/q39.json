  "variant": "raw",
  "sql": "SELECT\n    ps.ProductSubcategoryName,\n    toYear(fs.DateKey)                                                                                    AS SaleYear,\n    uniqIf(fs.ProductKey, toYear(toDate(p.AvailableForSaleDate)) = toYear(fs.DateKey))                   AS NewProductsIntroduced,\n    uniqIf(fs.ProductKey, toYear(toDate(p.AvailableForSaleDate)) < toYear(fs.DateKey)\n                          OR p.AvailableForSaleDate IS NULL)                                              AS ExistingProductsSold,\n    round(sumIf(fs.SalesAmount, toYear(toDate(p.AvailableForSaleDate)) = toYear(fs.DateKey)), 2)          AS NewProductSalesAmount,\n    round(sumIf(fs.SalesAmount, toYear(toDate(p.AvailableForSaleDate)) < toYear(fs.DateKey)\n                                OR p.AvailableForSaleDate IS NULL), 2)                                    AS ExistingProductSalesAmount,\n    round(\n        100.0 * sumIf(fs.SalesAmount, toYear(toDate(p.AvailableForSaleDate)) < toYear(fs.DateKey)\n                                      OR p.AvailableForSaleDate IS NULL)\n        / nullIf(\n            lagInFrame(\n                sumIf(fs.SalesAmount, toYear(toDate(p.AvailableForSaleDate)) < toYear(fs.DateKey)\n                                      OR p.AvailableForSaleDate IS NULL)\n            ) OVER (PARTITION BY ps.ProductSubcategoryName ORDER BY toYear(fs.DateKey)),\n            0\n          ) - 100.0,\n    2)                                                                                                    AS ExistingProductSalesYoYPct\nFROM retail.FactSales fs\nJOIN retail.DimProduct p\n    ON fs.ProductKey = p.ProductKey\nJOIN retail.DimProductSubcategory ps\n    ON toInt32(p.ProductSubcategoryKey) = ps.ProductSubcategoryKey\nGROUP BY\n    ps.ProductSubcategoryName,\n    SaleYear\nORDER BY\n    ps.ProductSubcategoryName,\n    SaleYear;",

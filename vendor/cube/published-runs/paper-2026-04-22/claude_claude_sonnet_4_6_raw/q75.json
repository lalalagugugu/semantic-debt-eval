  "variant": "raw",
  "sql": "SELECT\n    c.CustomerKey,\n    c.FirstName,\n    c.LastName,\n    sum(CASE WHEN toYear(f.DateKey) = 2008 THEN f.SalesAmount ELSE 0 END) AS spending_2008,\n    sum(CASE WHEN toYear(f.DateKey) = 2009 THEN f.SalesAmount ELSE 0 END) AS spending_2009,\n    round((spending_2009 - spending_2008) / spending_2008 * 100, 2) AS pct_increase\nFROM retail.FactOnlineSales f\nJOIN retail.DimCustomer c ON f.CustomerKey = c.CustomerKey\nWHERE toYear(f.DateKey) IN (2008, 2009)\nGROUP BY c.CustomerKey, c.FirstName, c.LastName\nHAVING spending_2008 > 0\n   AND spending_2009 > spending_2008 * 1.5\nORDER BY pct_increase DESC",

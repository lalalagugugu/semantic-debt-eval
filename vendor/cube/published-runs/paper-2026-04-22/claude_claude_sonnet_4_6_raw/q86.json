  "sql": "SELECT\n    ps.ProductSubcategoryName,\n    pc.ProductCategoryName,\n    count() AS TransactionCount,\n    round(avg(p.DiscountPercent), 4) AS AvgDiscountPct,\n    sum(fs.SalesQuantity) AS TotalSalesQty,\n    round(corr(p.DiscountPercent, fs.SalesQuantity), 6) AS CorrDiscountVsSalesQty\nFROM retail.FactSales fs\nJOIN retail.DimPromotion p ON fs.PromotionKey = p.PromotionKey\nJOIN retail.DimProduct prod ON fs.ProductKey = prod.ProductKey\nJOIN retail.DimProductSubcategory ps\n    ON toInt32(prod.ProductSubcategoryKey) = ps.ProductSubcategoryKey\nJOIN retail.DimProductCategory pc\n    ON ps.ProductCategoryKey = pc.ProductCategoryKey\nWHERE toYear(fs.DateKey) = 2009\n  AND p.DiscountPercent IS NOT NULL\n  AND p.DiscountPercent > 0\nGROUP BY\n    ps.ProductSubcategoryName,\n    pc.ProductCategoryName\nHAVING TransactionCount >= 30\nORDER BY CorrDiscountVsSalesQty DESC",

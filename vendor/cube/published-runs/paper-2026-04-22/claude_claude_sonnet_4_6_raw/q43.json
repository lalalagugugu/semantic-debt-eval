  "sql": "SELECT\n    dst.SalesTerritoryRegion AS Region,\n    sum(fs.SalesAmount) AS TotalSales,\n    sum(fs.TotalCost) AS TotalCost,\n    sum(fs.SalesAmount - fs.TotalCost) AS GrossMargin,\n    round(100.0 * sum(fs.SalesAmount - fs.TotalCost) / nullIf(sum(fs.SalesAmount), 0), 2) AS GrossMarginPct\nFROM retail.FactSales fs\nJOIN retail.DimStore ds ON fs.StoreKey = ds.StoreKey\nJOIN retail.DimSalesTerritory dst ON ds.GeographyKey = dst.GeographyKey\nWHERE dst.SalesTerritoryRegion IS NOT NULL\nGROUP BY dst.SalesTerritoryRegion\nORDER BY GrossMargin DESC",

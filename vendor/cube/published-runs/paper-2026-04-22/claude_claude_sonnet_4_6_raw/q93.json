  "sql": "SELECT\n    p.PromotionName,\n    p.PromotionType,\n    p.PromotionCategory,\n    round(p.DiscountPercent, 2) AS DiscountPercent,\n    count(DISTINCT s.SalesKey) AS NumberOfTransactions,\n    sum(s.SalesQuantity) AS TotalUnitsSold,\n    round(sum(s.SalesAmount), 2) AS TotalSalesAmount,\n    round(avg(s.SalesQuantity), 4) AS AvgUnitsPerTransaction,\n    round(sum(s.SalesQuantity) / sum(s.SalesAmount + s.DiscountAmount) * 100, 4) AS UnitsPer100Revenue,\n    round(corr(p.DiscountPercent, s.SalesQuantity), 4) AS CorrDiscountVsQty\nFROM retail.FactSales AS s\nJOIN retail.DimPromotion AS p ON s.PromotionKey = p.PromotionKey\nWHERE p.DiscountPercent IS NOT NULL AND p.DiscountPercent > 0\nGROUP BY\n    p.PromotionName,\n    p.PromotionType,\n    p.PromotionCategory,\n    p.DiscountPercent\nORDER BY p.DiscountPercent DESC",

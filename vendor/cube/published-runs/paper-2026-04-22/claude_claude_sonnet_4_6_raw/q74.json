  "variant": "raw",
  "sql": "SELECT\n    StoreKey,\n    ProductKey,\n    ProductName,\n    product_sales,\n    store_total_sales,\n    round(product_sales / store_total_sales * 100, 2) AS pct_of_store,\n    rnk\nFROM (\n    SELECT\n        fs.StoreKey,\n        fs.ProductKey,\n        dp.ProductName,\n        sum(fs.SalesAmount) AS product_sales,\n        sum(sum(fs.SalesAmount)) OVER (PARTITION BY fs.StoreKey) AS store_total_sales,\n        rank() OVER (PARTITION BY fs.StoreKey ORDER BY sum(fs.SalesAmount) DESC) AS rnk\n    FROM retail.FactSales fs\n    JOIN retail.DimProduct dp ON dp.ProductKey = fs.ProductKey\n    WHERE toYear(fs.DateKey) = 2009\n    GROUP BY fs.StoreKey, fs.ProductKey, dp.ProductName\n)\nWHERE rnk <= 3\nORDER BY StoreKey, rnk",

  "variant": "raw",
  "sql": "SELECT\n    CustomerKey,\n    max(DateKey) AS last_purchase_date,\n    dateDiff('day', max(DateKey), today()) AS days_since_last_purchase,\n    CASE\n        WHEN dateDiff('day', max(DateKey), today()) <= 90  THEN 'Active'\n        WHEN dateDiff('day', max(DateKey), today()) <= 180 THEN 'At Risk'\n        ELSE 'Churned'\n    END AS customer_segment,\n    count() AS total_orders,\n    sum(SalesAmount) AS total_sales_amount\nFROM retail.FactOnlineSales\nGROUP BY CustomerKey\nORDER BY last_purchase_date DESC",

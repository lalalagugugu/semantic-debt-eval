  "sql": "SELECT\n    p.BrandName,\n    sum(f.SalesAmount) AS TotalOnlineRevenue,\n    sum(f.SalesQuantity) AS TotalUnitsSold\nFROM retail.FactOnlineSales f\nJOIN retail.DimProduct p ON f.ProductKey = p.ProductKey\nWHERE toYear(f.DateKey) = 2008\nGROUP BY p.BrandName\nHAVING TotalUnitsSold >= 500\nORDER BY TotalOnlineRevenue DESC",

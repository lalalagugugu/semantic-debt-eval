{
  "question_id": 49,
  "model": "claude-sonnet-4-6",
  "variant": "semantic",
  "sql": "SELECT\n    COALESCE(e3.EntityName, e2.EntityName, e1.EntityName) AS level1_entity,\n    COALESCE(e2.EntityName, e1.EntityName, NULL)           AS level2_entity,\n    e1.EntityName                                          AS level3_entity,\n    e1.EntityType                                          AS entity_type,\n    sum(fs.SalesAmount)                                    AS total_sales,\n    sum(fs.TotalCost)                                      AS total_cost,\n    sum(fs.SalesAmount) - sum(fs.TotalCost)                AS gross_margin,\n    round(\n        (sum(fs.SalesAmount) - sum(fs.TotalCost))\n        / nullIf(sum(fs.SalesAmount), 0) * 100,\n        2\n    )                                                      AS gross_margin_pct\nFROM retail.FactSales fs\nJOIN retail.DimStore ds\n    ON fs.StoreKey = ds.StoreKey\n   AND ds.EntityKey IS NOT NULL\nJOIN retail.DimEntity e1\n    ON toInt32(ds.EntityKey) = e1.EntityKey\nLEFT JOIN retail.DimEntity e2\n    ON toInt32(e1.ParentEntityKey) = e2.EntityKey\nLEFT JOIN retail.DimEntity e3\n    ON toInt32(e2.ParentEntityKey) = e3.EntityKey\nGROUP BY\n    level1_entity,\n    level2_entity,\n    level3_entity,\n    entity_type\nORDER BY\n    level1_entity,\n    level2_entity NULLS LAST,\n    level3_entity NULLS LAST",

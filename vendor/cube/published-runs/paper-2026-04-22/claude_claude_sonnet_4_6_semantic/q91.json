  "sql": "SELECT\n    c.YearlyIncome,\n    count(DISTINCT f.CustomerKey)                                    AS num_customers,\n    sum(f.SalesAmount)                                               AS total_sales,\n    sum(f.SalesAmount) / countDistinct(f.CustomerKey)               AS avg_spend_per_customer,\n    sum(f.SalesQuantity) / countDistinct(f.CustomerKey)             AS avg_units_per_customer,\n    countDistinct(f.SalesOrderNumber) / countDistinct(f.CustomerKey) AS avg_orders_per_customer\nFROM retail.FactOnlineSales f\nJOIN retail.DimCustomer c ON f.CustomerKey = c.CustomerKey\nWHERE c.YearlyIncome IS NOT NULL\nGROUP BY c.YearlyIncome\nORDER BY c.YearlyIncome ASC",

  "sql": "SELECT\n    p.ProductKey,\n    p.ProductName,\n    sumIf(f.SalesAmount, toMonth(f.DateKey) <= 6)  AS h1_sales,\n    sumIf(f.SalesAmount, toMonth(f.DateKey) >= 7)  AS h2_sales,\n    h2_sales - h1_sales                            AS comeback_delta,\n    round(h2_sales / nullIf(h1_sales, 0), 4)       AS h2_h1_ratio\nFROM retail.FactOnlineSales f\nJOIN retail.DimProduct p ON f.ProductKey = p.ProductKey\nWHERE toYear(f.DateKey) = 2009\nGROUP BY\n    p.ProductKey,\n    p.ProductName\nHAVING h1_sales > 0\n   AND h2_sales > h1_sales\nORDER BY comeback_delta DESC\nLIMIT 20",

  "sql": "SELECT\n    p.BrandName,\n    sum(s.SalesAmount) AS total_sales,\n    sum(s.TotalCost)   AS total_cost,\n    sum(s.SalesAmount) - sum(s.TotalCost) AS gross_margin\nFROM retail.FactOnlineSales s\nJOIN retail.DimProduct p ON s.ProductKey = p.ProductKey\nWHERE toYear(s.DateKey) = 2009\n  AND toQuarter(s.DateKey) = 4\n  AND p.BrandName IS NOT NULL\nGROUP BY p.BrandName\nORDER BY gross_margin DESC",

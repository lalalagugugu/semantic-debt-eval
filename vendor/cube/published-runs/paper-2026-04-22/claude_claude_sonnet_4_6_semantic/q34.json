  "variant": "semantic",
  "sql": "SELECT\n    p.ProductKey,\n    p.ProductName,\n    c.total_cogs,\n    ai.avg_inventory_value,\n    c.total_cogs / nullif(ai.avg_inventory_value, 0) AS inventory_turnover_ratio\nFROM (\n    SELECT\n        ProductKey,\n        sum(TotalCost) AS total_cogs\n    FROM retail.FactOnlineSales\n    WHERE toYear(DateKey) = 2009\n    GROUP BY ProductKey\n) c\nJOIN (\n    SELECT\n        ProductKey,\n        avg(OnHandQuantity * UnitCost) AS avg_inventory_value\n    FROM retail.FactInventory\n    WHERE toYear(DateKey) = 2009\n    GROUP BY ProductKey\n) ai ON c.ProductKey = ai.ProductKey\nJOIN retail.DimProduct p ON c.ProductKey = p.ProductKey\nORDER BY inventory_turnover_ratio DESC",

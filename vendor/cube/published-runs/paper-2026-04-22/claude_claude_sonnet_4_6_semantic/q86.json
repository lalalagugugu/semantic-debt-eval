  "variant": "semantic",
  "sql": "SELECT\n    psc.ProductSubcategoryName,\n    corr(p.DiscountPercent, f.SalesQuantity)                                   AS discount_sales_corr,\n    count()                                                                     AS num_line_items,\n    round(avg(p.DiscountPercent), 2)                                            AS avg_discount_pct,\n    sum(f.SalesQuantity)                                                        AS total_sales_qty,\n    sum(f.SalesAmount)                                                          AS total_sales_amount,\n    countDistinct(f.PromotionKey)                                               AS distinct_promotions\nFROM retail.FactOnlineSales       f\nJOIN retail.DimPromotion          p   ON f.PromotionKey          = p.PromotionKey\nJOIN retail.DimProduct            dp  ON f.ProductKey            = dp.ProductKey\nJOIN retail.DimProductSubcategory psc ON dp.ProductSubcategoryKey = psc.ProductSubcategoryKey\nWHERE toYear(f.DateKey) = 2009\n  AND f.PromotionKey <> 1          -- exclude \"No Discount\" rows; need actual discount depth\n  AND p.DiscountPercent IS NOT NULL\nGROUP BY psc.ProductSubcategoryName\nHAVING num_line_items >= 30        -- require enough data points for a meaningful correlation\nORDER BY discount_sales_corr DESC",

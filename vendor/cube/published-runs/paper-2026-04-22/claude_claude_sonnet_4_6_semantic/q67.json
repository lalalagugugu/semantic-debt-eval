  "sql": "SELECT\n    p.ColorName,\n    sum(f.SalesAmount) / sum(f.SalesQuantity) AS avg_realized_unit_price,\n    sum(f.SalesQuantity) AS total_units_sold\nFROM retail.FactOnlineSales f\nJOIN retail.DimProduct p ON f.ProductKey = p.ProductKey\nWHERE p.ColorName IS NOT NULL\nGROUP BY p.ColorName\nHAVING sum(f.SalesQuantity) >= 1000\nORDER BY avg_realized_unit_price DESC",

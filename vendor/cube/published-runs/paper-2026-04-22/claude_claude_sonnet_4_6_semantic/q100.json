  "variant": "semantic",
  "sql": "WITH customer_metrics AS (\n    SELECT\n        CustomerKey,\n        countDistinct(SalesOrderNumber)                                      AS order_count,\n        sum(SalesAmount) / countDistinct(SalesOrderNumber)                   AS avg_order_size\n    FROM retail.FactOnlineSales\n    GROUP BY CustomerKey\n),\nthresholds AS (\n    SELECT\n        quantile(0.9)(order_count)     AS order_count_p90,\n        quantile(0.9)(avg_order_size)  AS avg_order_size_p90\n    FROM customer_metrics\n)\nSELECT\n    cm.CustomerKey,\n    dc.FirstName,\n    dc.LastName,\n    cm.order_count,\n    round(cm.avg_order_size, 2) AS avg_order_size\nFROM customer_metrics cm\nCROSS JOIN thresholds t\nJOIN retail.DimCustomer dc ON cm.CustomerKey = dc.CustomerKey\nWHERE cm.order_count    >= t.order_count_p90\n  AND cm.avg_order_size >= t.avg_order_size_p90\nORDER BY cm.order_count DESC, cm.avg_order_size DESC",

  "sql": "SELECT\n    f.CustomerKey,\n    c.FirstName,\n    c.LastName,\n    sum(f.SalesAmount) AS TotalSpend\nFROM retail.FactOnlineSales f\nJOIN retail.DimCustomer c ON f.CustomerKey = c.CustomerKey\nWHERE toYear(f.DateKey) = 2009\nGROUP BY f.CustomerKey, c.FirstName, c.LastName\nHAVING countDistinct(toQuarter(f.DateKey)) = 4\nORDER BY TotalSpend DESC\nLIMIT 20",

  "sql": "SELECT\n    g.RegionCountryName AS Region,\n    sum(f.SalesAmount) AS TotalSales,\n    sum(f.TotalCost) AS TotalCost,\n    sum(f.SalesAmount) - sum(f.TotalCost) AS GrossMargin,\n    (sum(f.SalesAmount) - sum(f.TotalCost)) / nullif(sum(f.SalesAmount), 0) AS GrossMarginPct\nFROM retail.FactOnlineSales f\nJOIN retail.DimCustomer c ON f.CustomerKey = c.CustomerKey\nJOIN retail.DimGeography g ON c.GeographyKey = g.GeographyKey\nGROUP BY g.RegionCountryName\nORDER BY GrossMargin DESC",

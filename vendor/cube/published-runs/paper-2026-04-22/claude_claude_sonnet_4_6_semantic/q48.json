  "sql": "SELECT\n    s.StoreKey,\n    s.month,\n    s.total_sales,\n    coalesce(o.total_downtime_minutes, 0)                                                     AS total_downtime_minutes,\n    round(corr(coalesce(o.total_downtime_minutes, 0), s.total_sales) OVER (), 4)              AS pearson_correlation_overall\nFROM (\n    SELECT\n        StoreKey,\n        toStartOfMonth(DateKey) AS month,\n        sum(SalesAmount)        AS total_sales\n    FROM retail.FactOnlineSales\n    GROUP BY StoreKey, month\n) s\nLEFT JOIN (\n    SELECT\n        StoreKey,\n        toStartOfMonth(DateKey) AS month,\n        sum(DownTime)           AS total_downtime_minutes\n    FROM retail.FactITSLA\n    GROUP BY StoreKey, month\n) o ON s.StoreKey = o.StoreKey\n   AND s.month    = o.month\nORDER BY s.StoreKey, s.month",

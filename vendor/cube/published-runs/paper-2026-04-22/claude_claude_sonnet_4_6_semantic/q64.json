  "sql": "SELECT\n    toMonth(DateKey) AS MonthNumber,\n    any(dd.CalendarMonthLabel) AS MonthLabel,\n    sum(SalesAmount) - sum(TotalCost) AS GrossMarginDollars,\n    (sum(SalesAmount) - sum(TotalCost)) / nullif(sum(SalesAmount), 0) AS GrossMarginPct\nFROM retail.FactOnlineSales f\nJOIN retail.DimDate dd ON dd.DateKey = f.DateKey\nWHERE toYear(f.DateKey) = 2009\nGROUP BY MonthNumber\nORDER BY MonthNumber",

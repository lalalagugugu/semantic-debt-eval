  "sql": "SELECT\n    toMonth(DateKey) AS month_number,\n    any(d.CalendarMonthLabel) AS month_label,\n    sum(SalesAmount) AS monthly_sales,\n    sum(sum(SalesAmount)) OVER (ORDER BY toMonth(DateKey) ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_sales\nFROM retail.FactOnlineSales f\nJOIN retail.DimDate d ON d.DateKey = f.DateKey\nWHERE toYear(f.DateKey) = 2009\nGROUP BY month_number\nORDER BY month_number",

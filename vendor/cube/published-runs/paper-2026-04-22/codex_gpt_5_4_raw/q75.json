  "variant": "raw",
  "sql": "SELECT\n    c.CustomerKey,\n    c.FirstName,\n    c.LastName,\n    sumIf(os.SalesAmount, toYear(os.DateKey) = 2008) AS spend_2008,\n    sumIf(os.SalesAmount, toYear(os.DateKey) = 2009) AS spend_2009,\n    (sumIf(os.SalesAmount, toYear(os.DateKey) = 2009) - sumIf(os.SalesAmount, toYear(os.DateKey) = 2008)) / sumIf(os.SalesAmount, toYear(os.DateKey) = 2008) AS growth_rate\nFROM retail.FactOnlineSales AS os\nINNER JOIN retail.DimCustomer AS c\n    ON os.CustomerKey = c.CustomerKey\nWHERE toYear(os.DateKey) IN (2008, 2009)\nGROUP BY\n    c.CustomerKey,\n    c.FirstName,\n    c.LastName\nHAVING spend_2008 > 0\n   AND spend_2009 > spend_2008 * 1.5\nORDER BY growth_rate DESC, spend_2009 DESC",

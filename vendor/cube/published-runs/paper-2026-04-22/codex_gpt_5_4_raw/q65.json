  "variant": "raw",
  "sql": "SELECT DISTINCT s.StoreManager\nFROM retail.DimStore AS s\nINNER JOIN\n(\n    SELECT StoreKey, sum(TotalSales) AS TotalAllChannelSales\n    FROM\n    (\n        SELECT StoreKey, sum(SalesAmount) AS TotalSales\n        FROM retail.FactSales\n        GROUP BY StoreKey\n\n        UNION ALL\n\n        SELECT StoreKey, sum(SalesAmount) AS TotalSales\n        FROM retail.FactOnlineSales\n        GROUP BY StoreKey\n    )\n    GROUP BY StoreKey\n) AS t\n    ON s.StoreKey = t.StoreKey\nWHERE t.TotalAllChannelSales > 5000000\n  AND s.StoreManager IS NOT NULL\nORDER BY s.StoreManager",

  "variant": "raw",
  "sql": "SELECT\n    p.ProductKey,\n    p.ProductName,\n    ifNull(s.cost_of_goods_sold / nullIf(i.avg_inventory_value, 0), 0) AS inventory_turnover_ratio\nFROM retail.DimProduct AS p\nLEFT JOIN\n(\n    SELECT\n        ProductKey,\n        sum(TotalCost) AS cost_of_goods_sold\n    FROM retail.FactSales\n    WHERE toYear(DateKey) = 2009\n    GROUP BY ProductKey\n) AS s\n    ON p.ProductKey = s.ProductKey\nLEFT JOIN\n(\n    SELECT\n        ProductKey,\n        avg(OnHandQuantity * UnitCost) AS avg_inventory_value\n    FROM retail.FactInventory\n    WHERE toYear(DateKey) = 2009\n    GROUP BY ProductKey\n) AS i\n    ON p.ProductKey = i.ProductKey\nWHERE s.ProductKey IS NOT NULL OR i.ProductKey IS NOT NULL\nORDER BY inventory_turnover_ratio DESC, p.ProductKey;",

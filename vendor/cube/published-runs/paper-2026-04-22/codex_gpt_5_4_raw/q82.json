  "sql": "SELECT\n    m.EmployeeKey AS ManagerKey,\n    concat(m.FirstName, ' ', m.LastName) AS ManagerName,\n    count() AS DirectReportCount,\n    avg(dateDiff('day', parseDateTimeBestEffortOrNull(e.HireDate), today()) / 365.25) AS AvgHireTenureYears\nFROM retail.DimEmployee AS e\nINNER JOIN retail.DimEmployee AS m\n    ON e.ParentEmployeeKey = m.EmployeeKey\nWHERE parseDateTimeBestEffortOrNull(e.HireDate) IS NOT NULL\nGROUP BY\n    m.EmployeeKey,\n    m.FirstName,\n    m.LastName\nORDER BY DirectReportCount DESC, ManagerName ASC",

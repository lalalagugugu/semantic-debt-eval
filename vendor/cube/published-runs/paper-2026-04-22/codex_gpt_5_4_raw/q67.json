  "sql": "SELECT\n    p.ColorName,\n    sum(os.SalesQuantity) AS total_units_sold,\n    sum(os.SalesAmount) / sum(os.SalesQuantity) AS avg_realized_online_unit_price\nFROM retail.FactOnlineSales AS os\nINNER JOIN retail.DimProduct AS p\n    ON os.ProductKey = p.ProductKey\nWHERE p.ColorName IS NOT NULL\nGROUP BY p.ColorName\nHAVING sum(os.SalesQuantity) >= 1000\nORDER BY avg_realized_online_unit_price DESC\nLIMIT 10",

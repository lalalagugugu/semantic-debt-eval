  "variant": "raw",
  "sql": "SELECT\n    d.DateKey,\n    ifNull(s.daily_online_sales, 0) AS daily_online_sales,\n    avg(ifNull(s.daily_online_sales, 0)) OVER (\n        ORDER BY d.DateKey\n        ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n    ) AS moving_avg_7d\nFROM retail.DimDate AS d\nLEFT JOIN\n(\n    SELECT\n        DateKey,\n        sum(SalesAmount) AS daily_online_sales\n    FROM retail.FactOnlineSales\n    WHERE toYear(DateKey) = 2009\n      AND toMonth(DateKey) = 12\n    GROUP BY DateKey\n) AS s\n    ON d.DateKey = s.DateKey\nWHERE d.CalendarYear = 2009\n  AND d.MonthNumber = 12\nORDER BY d.DateKey;",

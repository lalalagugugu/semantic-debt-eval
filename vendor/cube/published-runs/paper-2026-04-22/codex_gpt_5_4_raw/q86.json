  "sql": "SELECT\n    dps.ProductSubcategoryName AS product_subcategory,\n    corr(ifNull(dp.DiscountPercent, 0.0), toFloat64(fs.SalesQuantity)) AS discount_sales_quantity_correlation\nFROM retail.FactSales AS fs\nINNER JOIN retail.DimDate AS dd\n    ON fs.DateKey = dd.DateKey\nINNER JOIN retail.DimProduct AS pr\n    ON fs.ProductKey = pr.ProductKey\nINNER JOIN retail.DimProductSubcategory AS dps\n    ON toInt32(pr.ProductSubcategoryKey) = dps.ProductSubcategoryKey\nINNER JOIN retail.DimPromotion AS dp\n    ON fs.PromotionKey = dp.PromotionKey\nWHERE dd.CalendarYear = 2009\nGROUP BY dps.ProductSubcategoryName\nORDER BY dps.ProductSubcategoryName",

  "variant": "raw",
  "sql": "SELECT\n    fi.StoreKey,\n    ds.StoreName,\n    fi.ProductKey,\n    dp.ProductName,\n    fi.DateKey AS InventoryDate,\n    fi.OnHandQuantity AS CurrentInventoryLevel,\n    fi.OnOrderQuantity,\n    fi.SafetyStockQuantity\nFROM retail.FactInventory AS fi\nINNER JOIN\n(\n    SELECT\n        StoreKey,\n        ProductKey,\n        max(DateKey) AS MaxDateKey\n    FROM retail.FactInventory\n    GROUP BY\n        StoreKey,\n        ProductKey\n) AS latest\n    ON fi.StoreKey = latest.StoreKey\n   AND fi.ProductKey = latest.ProductKey\n   AND fi.DateKey = latest.MaxDateKey\nLEFT JOIN retail.DimStore AS ds\n    ON fi.StoreKey = ds.StoreKey\nLEFT JOIN retail.DimProduct AS dp\n    ON fi.ProductKey = dp.ProductKey\nORDER BY\n    ds.StoreName,\n    dp.ProductName",

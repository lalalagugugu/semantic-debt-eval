  "sql": "SELECT\n    fos.CustomerKey,\n    dc.FirstName,\n    dc.LastName,\n    sum(fos.SalesAmount) AS total_spend\nFROM retail.FactOnlineSales AS fos\nINNER JOIN retail.DimCustomer AS dc\n    ON fos.CustomerKey = dc.CustomerKey\nWHERE toYear(fos.DateKey) = 2009\nGROUP BY\n    fos.CustomerKey,\n    dc.FirstName,\n    dc.LastName\nHAVING countDistinct(toQuarter(fos.DateKey)) = 4\nORDER BY total_spend DESC\nLIMIT 20",

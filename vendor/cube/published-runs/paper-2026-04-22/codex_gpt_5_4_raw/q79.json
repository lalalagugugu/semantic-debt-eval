  "variant": "raw",
  "sql": "SELECT\n    s.StoreKey,\n    ds.StoreName,\n    sum(s.SalesAmount) AS total_sales_amount,\n    q.total_sales_quota,\n    total_sales_amount / q.total_sales_quota AS sales_to_quota_attainment\nFROM retail.FactSales AS s\nINNER JOIN\n(\n    SELECT\n        StoreKey,\n        sum(SalesAmountQuota) AS total_sales_quota\n    FROM retail.FactSalesQuota\n    WHERE toYear(DateKey) = 2009\n    GROUP BY StoreKey\n    HAVING total_sales_quota > 0\n) AS q\n    ON s.StoreKey = q.StoreKey\nINNER JOIN retail.DimStore AS ds\n    ON s.StoreKey = ds.StoreKey\nWHERE toYear(s.DateKey) = 2009\nGROUP BY\n    s.StoreKey,\n    ds.StoreName,\n    q.total_sales_quota\nORDER BY sales_to_quota_attainment DESC\nLIMIT 10",

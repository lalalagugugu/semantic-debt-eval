  "sql": "SELECT\n    p.BrandName AS brand,\n    sum(os.SalesAmount) AS total_online_revenue,\n    sum(os.SalesQuantity) AS units_sold\nFROM retail.FactOnlineSales AS os\nINNER JOIN retail.DimProduct AS p\n    ON os.ProductKey = p.ProductKey\nWHERE toYear(os.DateKey) = 2008\n    AND p.BrandName IS NOT NULL\nGROUP BY p.BrandName\nHAVING sum(os.SalesQuantity) >= 500\nORDER BY units_sold DESC, total_online_revenue DESC",

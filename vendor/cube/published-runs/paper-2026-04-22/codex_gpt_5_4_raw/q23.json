  "sql": "SELECT\n    month,\n    monthly_sales,\n    sum(monthly_sales) OVER (ORDER BY month ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_monthly_sales\nFROM\n(\n    SELECT\n        toMonth(DateKey) AS month,\n        sum(SalesAmount) AS monthly_sales\n    FROM retail.FactSales\n    WHERE toYear(DateKey) = 2009\n    GROUP BY month\n)\nORDER BY month",

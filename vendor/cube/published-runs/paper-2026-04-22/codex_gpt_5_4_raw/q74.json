{
  "question_id": 74,
  "model": "gpt-5.4",
  "variant": "raw",
  "sql": "SELECT\n    s.StoreKey,\n    st.StoreName,\n    s.ProductKey,\n    p.ProductName,\n    s.product_sales,\n    s.store_total_sales,\n    s.product_sales / s.store_total_sales AS sales_share,\n    s.sales_rank\nFROM\n(\n    SELECT\n        StoreKey,\n        ProductKey,\n        product_sales,\n        sum(product_sales) OVER (PARTITION BY StoreKey) AS store_total_sales,\n        row_number() OVER (PARTITION BY StoreKey ORDER BY product_sales DESC, ProductKey) AS sales_rank\n    FROM\n    (\n        SELECT\n            StoreKey,\n            ProductKey,\n            sum(SalesAmount) AS product_sales\n        FROM retail.FactSales\n        WHERE toYear(DateKey) = 2009\n        GROUP BY\n            StoreKey,\n            ProductKey\n    )\n) AS s\nINNER JOIN retail.DimStore AS st\n    ON s.StoreKey = st.StoreKey\nINNER JOIN retail.DimProduct AS p\n    ON s.ProductKey = p.ProductKey\nWHERE s.sales_rank <= 3\nORDER BY\n    s.StoreKey,\n    s.sales_rank,\n    s.ProductKey;",

  "variant": "raw",
  "sql": "WITH\n    (SELECT max(DateKey) FROM retail.FactOnlineSales) AS max_date,\n    customer_recency AS\n    (\n        SELECT\n            c.CustomerKey,\n            c.FirstName,\n            c.LastName,\n            max(os.DateKey) AS last_purchase_date,\n            dateDiff('day', max(os.DateKey), max_date) AS recency_days\n        FROM retail.DimCustomer AS c\n        LEFT JOIN retail.FactOnlineSales AS os\n            ON c.CustomerKey = os.CustomerKey\n        GROUP BY\n            c.CustomerKey,\n            c.FirstName,\n            c.LastName\n    )\nSELECT\n    CustomerKey,\n    FirstName,\n    LastName,\n    last_purchase_date,\n    recency_days,\n    multiIf(\n        last_purchase_date IS NULL OR recency_days > 180, 'Churned',\n        recency_days > 90, 'At Risk',\n        'Active'\n    ) AS customer_status\nFROM customer_recency\nORDER BY CustomerKey",

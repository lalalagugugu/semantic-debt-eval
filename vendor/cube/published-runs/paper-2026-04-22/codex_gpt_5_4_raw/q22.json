  "variant": "raw",
  "sql": "SELECT\n    country,\n    customer_key,\n    customer_name,\n    total_spend,\n    country_rank\nFROM\n(\n    SELECT\n        g.RegionCountryName AS country,\n        c.CustomerKey AS customer_key,\n        concat(c.FirstName, ' ', c.LastName) AS customer_name,\n        sum(os.SalesAmount) AS total_spend,\n        row_number() OVER (\n            PARTITION BY g.RegionCountryName\n            ORDER BY sum(os.SalesAmount) DESC, c.CustomerKey\n        ) AS country_rank\n    FROM retail.FactOnlineSales AS os\n    INNER JOIN retail.DimCustomer AS c\n        ON os.CustomerKey = c.CustomerKey\n    INNER JOIN retail.DimGeography AS g\n        ON c.GeographyKey = g.GeographyKey\n    GROUP BY\n        g.RegionCountryName,\n        c.CustomerKey,\n        c.FirstName,\n        c.LastName\n)\nWHERE country_rank <= 5\nORDER BY country, country_rank, customer_key;",

  "variant": "raw",
  "sql": "SELECT\n    s.StoreKey,\n    s.StoreName,\n    sumIf(f.SalesAmount, toQuarter(f.DateKey) = 3) AS q3_2009_sales,\n    sumIf(f.SalesAmount, toQuarter(f.DateKey) = 4) AS q4_2009_sales,\n    q4_2009_sales - q3_2009_sales AS sales_change,\n    round((q4_2009_sales - q3_2009_sales) / nullIf(q3_2009_sales, 0) * 100, 2) AS pct_change\nFROM retail.FactSales AS f\nINNER JOIN retail.DimStore AS s\n    ON f.StoreKey = s.StoreKey\nWHERE toYear(f.DateKey) = 2009\n  AND toQuarter(f.DateKey) IN (3, 4)\nGROUP BY\n    s.StoreKey,\n    s.StoreName\nHAVING q4_2009_sales < q3_2009_sales\nORDER BY pct_change ASC, sales_change ASC, s.StoreKey ASC",

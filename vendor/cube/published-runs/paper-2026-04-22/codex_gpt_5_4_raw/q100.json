  "variant": "raw",
  "sql": "WITH order_totals AS (\n    SELECT\n        CustomerKey,\n        SalesOrderNumber,\n        sum(SalesAmount) AS order_amount\n    FROM retail.FactOnlineSales\n    GROUP BY\n        CustomerKey,\n        SalesOrderNumber\n),\ncustomer_metrics AS (\n    SELECT\n        CustomerKey,\n        count() AS order_count,\n        avg(order_amount) AS avg_order_size,\n        sum(order_amount) AS total_sales\n    FROM order_totals\n    GROUP BY CustomerKey\n),\n(SELECT quantileExact(0.9)(order_count) FROM customer_metrics) AS order_count_p90,\n(SELECT quantileExact(0.9)(avg_order_size) FROM customer_metrics) AS avg_order_size_p90\nSELECT\n    cm.CustomerKey,\n    dc.FirstName,\n    dc.LastName,\n    cm.order_count,\n    round(cm.avg_order_size, 2) AS avg_order_size,\n    round(cm.total_sales, 2) AS total_sales\nFROM customer_metrics AS cm\nINNER JOIN retail.DimCustomer AS dc\n    ON dc.CustomerKey = cm.CustomerKey\nWHERE cm.order_count >= order_count_p90\n  AND cm.avg_order_size >= avg_order_size_p90\nORDER BY\n    cm.order_count DESC,\n    cm.avg_order_size DESC,\n    cm.total_sales DESC;",

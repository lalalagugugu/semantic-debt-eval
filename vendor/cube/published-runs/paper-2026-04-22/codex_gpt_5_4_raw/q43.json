  "variant": "raw",
  "sql": "SELECT\n    g.RegionCountryName AS region,\n    sum(s.gross_margin) AS gross_margin\nFROM\n(\n    SELECT\n        StoreKey,\n        SalesAmount - ReturnAmount - DiscountAmount - TotalCost AS gross_margin\n    FROM retail.FactSales\n    UNION ALL\n    SELECT\n        StoreKey,\n        SalesAmount - ReturnAmount - DiscountAmount - TotalCost AS gross_margin\n    FROM retail.FactOnlineSales\n) AS s\nINNER JOIN retail.DimStore st ON s.StoreKey = st.StoreKey\nINNER JOIN retail.DimGeography g ON st.GeographyKey = g.GeographyKey\nGROUP BY g.RegionCountryName\nORDER BY gross_margin DESC",

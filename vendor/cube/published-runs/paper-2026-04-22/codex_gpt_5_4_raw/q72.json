  "sql": "SELECT\n    year,\n    quarter,\n    quarterly_online_sales,\n    sum(quarterly_online_sales) OVER (ORDER BY year, quarter ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_cumulative_online_sales\nFROM\n(\n    SELECT\n        toYear(DateKey) AS year,\n        toQuarter(DateKey) AS quarter,\n        sum(SalesAmount) AS quarterly_online_sales\n    FROM retail.FactOnlineSales\n    WHERE toYear(DateKey) BETWEEN 2007 AND 2009\n    GROUP BY\n        year,\n        quarter\n)\nORDER BY\n    year,\n    quarter",

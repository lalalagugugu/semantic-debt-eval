  "sql": "SELECT toYear(DateKey) AS year, toQuarter(DateKey) AS quarter,\n       round(sum(SalesAmount), 2) AS quarterly_sales,\n       round(sum(sum(SalesAmount)) OVER (ORDER BY toYear(DateKey), toQuarter(DateKey) ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 2) AS cumulative_sales\nFROM retail.FactOnlineSales\nGROUP BY year, quarter\nORDER BY year, quarter",

{
  "question_id": 100,
  "sql": "WITH cust AS (\n  SELECT CustomerKey,\n         countDistinct(SalesOrderNumber) AS orders,\n         sum(SalesAmount) / nullif(countDistinct(SalesOrderNumber), 0) AS aov\n  FROM retail.FactOnlineSales\n  GROUP BY CustomerKey\n),\nthresholds AS (\n  SELECT quantile(0.9)(orders) AS orders_p90,\n         quantile(0.9)(aov) AS aov_p90\n  FROM cust\n)\nSELECT c.FirstName || ' ' || c.LastName AS customer_name,\n       cu.orders,\n       cu.aov,\n       cu.orders * cu.aov AS lifetime_value\nFROM cust cu\nCROSS JOIN thresholds t\nJOIN retail.DimCustomer c ON c.CustomerKey = cu.CustomerKey\nWHERE cu.orders >= t.orders_p90 AND cu.aov >= t.aov_p90\nORDER BY lifetime_value DESC\nLIMIT 30",

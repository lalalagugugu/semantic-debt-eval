  "variant": "raw",
  "sql": "SELECT ProductCategoryName, CalendarYear, max(QuarterSales) AS TopQuarterSales, sum(QuarterSales) AS AnnualSales, max(QuarterSales) / sum(QuarterSales) AS ConcentrationRatio FROM (SELECT pc.ProductCategoryName AS ProductCategoryName, d.CalendarYear AS CalendarYear, toQuarter(f.DateKey) AS Quarter, sum(f.SalesAmount) AS QuarterSales FROM retail.FactSales AS f INNER JOIN retail.DimDate AS d ON f.DateKey = d.DateKey INNER JOIN retail.DimProduct AS p ON f.ProductKey = p.ProductKey INNER JOIN retail.DimProductSubcategory AS ps ON p.ProductSubcategoryKey = ps.ProductSubcategoryKey INNER JOIN retail.DimProductCategory AS pc ON ps.ProductCategoryKey = pc.ProductCategoryKey GROUP BY pc.ProductCategoryName, d.CalendarYear, toQuarter(f.DateKey)) GROUP BY ProductCategoryName, CalendarYear ORDER BY ConcentrationRatio DESC",

  "sql": "SELECT s.StoreName, sum(f.SalesAmount) AS SalesAmount, sum(q.SalesAmountQuota) AS SalesQuota, sum(f.SalesAmount) / nullIf(sum(q.SalesAmountQuota), 0) AS Attainment\nFROM retail.FactSales AS f\nINNER JOIN (SELECT StoreKey, sum(SalesAmountQuota) AS SalesAmountQuota FROM retail.FactSalesQuota WHERE toYear(DateKey) = 2009 GROUP BY StoreKey) AS q ON f.StoreKey = q.StoreKey\nINNER JOIN retail.DimStore AS s ON f.StoreKey = s.StoreKey\nWHERE toYear(f.DateKey) = 2009\nGROUP BY s.StoreName, q.SalesAmountQuota\nORDER BY Attainment DESC\nLIMIT 10",

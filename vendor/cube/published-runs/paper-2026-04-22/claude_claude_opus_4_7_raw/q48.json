  "sql": "SELECT toYear(s.DateKey) AS Year, toMonth(s.DateKey) AS Month, COALESCE(o.OutageCount, 0) AS OutageCount, COALESCE(o.TotalDownTime, 0) AS TotalDownTime, SUM(s.SalesAmount) AS TotalSales, SUM(s.SalesQuantity) AS TotalSalesQuantity, COUNT(DISTINCT s.SalesKey) AS TransactionCount FROM retail.FactSales s LEFT JOIN (SELECT toYear(DateKey) AS Year, toMonth(DateKey) AS Month, COUNT(*) AS OutageCount, SUM(DownTime) AS TotalDownTime FROM retail.FactITSLA GROUP BY Year, Month) o ON toYear(s.DateKey) = o.Year AND toMonth(s.DateKey) = o.Month GROUP BY Year, Month, o.OutageCount, o.TotalDownTime ORDER BY Year, Month",

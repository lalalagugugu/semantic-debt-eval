  "variant": "raw",
  "sql": "SELECT\n    pc.ProductCategoryName AS ProductCategoryName,\n    toYear(s.DateKey) AS Year,\n    sum(s.SalesAmount) AS SalesAmount,\n    sum(s.TotalCost) AS TotalCost,\n    (sum(s.SalesAmount) - sum(s.TotalCost)) / nullIf(sum(s.SalesAmount), 0) * 100 AS GrossMarginPct,\n    GrossMarginPct - any(GrossMarginPct) OVER (PARTITION BY pc.ProductCategoryName ORDER BY toYear(s.DateKey) ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING) AS YoYChangePP\nFROM retail.FactSales AS s\nINNER JOIN retail.DimProduct AS p ON s.ProductKey = p.ProductKey\nINNER JOIN retail.DimProductSubcategory AS psc ON p.ProductSubcategoryKey = psc.ProductSubcategoryKey\nINNER JOIN retail.DimProductCategory AS pc ON psc.ProductCategoryKey = pc.ProductCategoryKey\nWHERE toYear(s.DateKey) IN (2007, 2008, 2009)\nGROUP BY pc.ProductCategoryName, toYear(s.DateKey)\nORDER BY pc.ProductCategoryName, Year",

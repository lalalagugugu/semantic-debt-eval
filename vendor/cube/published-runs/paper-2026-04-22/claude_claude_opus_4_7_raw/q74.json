  "sql": "SELECT StoreKey, ProductKey, ProductSales, StoreTotal, ProductSales / StoreTotal AS Share, rn AS Rank\nFROM (\n    SELECT StoreKey, ProductKey, ProductSales, StoreTotal,\n           row_number() OVER (PARTITION BY StoreKey ORDER BY ProductSales DESC) AS rn\n    FROM (\n        SELECT StoreKey, ProductKey,\n               sum(SalesAmount) AS ProductSales,\n               sum(sum(SalesAmount)) OVER (PARTITION BY StoreKey) AS StoreTotal\n        FROM retail.FactSales\n        WHERE toYear(DateKey) = 2009\n        GROUP BY StoreKey, ProductKey\n    )\n)\nWHERE rn <= 3\nORDER BY StoreKey, rn",

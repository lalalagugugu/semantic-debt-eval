  "sql": "SELECT psc.ProductSubcategoryName, sum(os.SalesAmount) AS TotalSales\nFROM retail.FactOnlineSales AS os\nINNER JOIN retail.DimProduct AS p ON os.ProductKey = p.ProductKey\nINNER JOIN retail.DimProductSubcategory AS psc ON p.ProductSubcategoryKey = psc.ProductSubcategoryKey\nWHERE toYear(os.DateKey) = 2009\nGROUP BY psc.ProductSubcategoryName\nHAVING TotalSales > 1000000\nORDER BY TotalSales DESC",

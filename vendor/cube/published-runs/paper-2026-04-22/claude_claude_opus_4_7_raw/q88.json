  "sql": "SELECT c.CustomerKey AS CustomerKey, any(c.FirstName) AS FirstName, any(c.LastName) AS LastName, sum(o.SalesAmount) AS TotalSpend\nFROM retail.FactOnlineSales AS o\nINNER JOIN retail.DimCustomer AS c ON c.CustomerKey = o.CustomerKey\nWHERE toYear(o.DateKey) = 2009\nGROUP BY c.CustomerKey\nHAVING uniqExact(toQuarter(o.DateKey)) = 4\nORDER BY TotalSpend DESC\nLIMIT 20",

  "sql": "SELECT\n    ifNull(c.Education, 'Unknown') AS Education,\n    ifNull(c.Occupation, 'Unknown') AS Occupation,\n    ifNull(c.Gender, 'Unknown') AS Gender,\n    ifNull(c.MaritalStatus, 'Unknown') AS MaritalStatus,\n    multiIf(c.YearlyIncome < 30000, '1: <30K',\n            c.YearlyIncome < 60000, '2: 30K-60K',\n            c.YearlyIncome < 90000, '3: 60K-90K',\n            c.YearlyIncome < 120000, '4: 90K-120K',\n            c.YearlyIncome >= 120000, '5: 120K+', 'Unknown') AS IncomeBand,\n    count(DISTINCT c.CustomerKey) AS Customers,\n    sum(o.SalesAmount - o.ReturnAmount - o.DiscountAmount) AS NetRevenue,\n    sum(o.TotalCost) AS TotalCost,\n    sum(o.SalesAmount - o.ReturnAmount - o.DiscountAmount - o.TotalCost) AS Profit,\n    Profit / nullIf(NetRevenue, 0) AS ProfitMargin,\n    Profit / nullIf(Customers, 0) AS ProfitPerCustomer\nFROM retail.FactOnlineSales AS o\nINNER JOIN retail.DimCustomer AS c ON o.CustomerKey = c.CustomerKey\nGROUP BY Education, Occupation, Gender, MaritalStatus, IncomeBand\nORDER BY Profit DESC\nLIMIT 20",

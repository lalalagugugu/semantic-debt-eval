  "sql": "SELECT s.StoreName, s.SellingAreaSize, sum(f.SalesAmount) AS TotalSales, sum(f.SalesAmount) / s.SellingAreaSize AS SalesPerSquareFoot FROM retail.FactSales f INNER JOIN retail.DimStore s ON f.StoreKey = s.StoreKey WHERE s.SellingAreaSize > 0 GROUP BY s.StoreName, s.SellingAreaSize ORDER BY SalesPerSquareFoot DESC LIMIT 20",

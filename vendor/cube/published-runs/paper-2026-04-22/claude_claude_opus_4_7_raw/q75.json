  "sql": "SELECT CustomerKey, sum(if(toYear(DateKey)=2008, SalesAmount, 0)) AS spend_2008, sum(if(toYear(DateKey)=2009, SalesAmount, 0)) AS spend_2009, (spend_2009 - spend_2008) / spend_2008 * 100 AS pct_increase FROM retail.FactOnlineSales WHERE toYear(DateKey) IN (2008, 2009) GROUP BY CustomerKey HAVING spend_2008 > 0 AND spend_2009 > spend_2008 * 1.5 ORDER BY pct_increase DESC",

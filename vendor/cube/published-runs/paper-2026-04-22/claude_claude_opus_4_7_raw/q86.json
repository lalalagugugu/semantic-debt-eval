  "sql": "SELECT psc.ProductSubcategoryName, corr(pr.DiscountPercent, s.SalesQuantity) AS discount_quantity_corr, count() AS sales_lines, sum(s.SalesQuantity) AS total_quantity FROM retail.FactSales AS s INNER JOIN retail.DimPromotion AS pr ON s.PromotionKey = pr.PromotionKey INNER JOIN retail.DimProduct AS p ON s.ProductKey = p.ProductKey INNER JOIN retail.DimProductSubcategory AS psc ON p.ProductSubcategoryKey = psc.ProductSubcategoryKey WHERE toYear(s.DateKey) = 2009 AND pr.DiscountPercent IS NOT NULL GROUP BY psc.ProductSubcategoryName ORDER BY discount_quantity_corr DESC",

  "sql": "SELECT e.EntityKey, e.EntityName, e.ParentEntityKey, e.ParentEntityLabel, sum(f.SalesAmount) AS TotalSalesAmount, sum(f.SalesQuantity) AS TotalSalesQuantity, sum(f.TotalCost) AS TotalCost, sum(f.SalesAmount - f.TotalCost) AS GrossMargin FROM retail.FactSales AS f INNER JOIN retail.DimStore AS s ON f.StoreKey = s.StoreKey INNER JOIN retail.DimEntity AS e ON toInt32(s.EntityKey) = e.EntityKey GROUP BY e.EntityKey, e.EntityName, e.ParentEntityKey, e.ParentEntityLabel ORDER BY TotalSalesAmount DESC",

  "variant": "raw",
  "sql": "SELECT p.ProductKey AS ProductKey, p.ProductName AS ProductName, sum(s.TotalCost) AS COGS, avg(i.OnHandQuantity * i.UnitCost) AS AvgInventoryValue, CASE WHEN avg(i.OnHandQuantity * i.UnitCost) = 0 THEN NULL ELSE sum(s.TotalCost) / avg(i.OnHandQuantity * i.UnitCost) END AS InventoryTurnoverRatio FROM retail.DimProduct AS p LEFT JOIN (SELECT ProductKey, sum(TotalCost) AS TotalCost FROM retail.FactSales WHERE toYear(DateKey) = 2009 GROUP BY ProductKey) AS s ON s.ProductKey = p.ProductKey LEFT JOIN (SELECT ProductKey, avg(OnHandQuantity * UnitCost) AS AvgInv FROM retail.FactInventory WHERE toYear(DateKey) = 2009 GROUP BY ProductKey) AS i2 ON i2.ProductKey = p.ProductKey LEFT JOIN retail.FactInventory AS i ON i.ProductKey = p.ProductKey AND toYear(i.DateKey) = 2009 LEFT JOIN retail.FactSales AS fs ON fs.ProductKey = p.ProductKey AND toYear(fs.DateKey) = 2009 GROUP BY p.ProductKey, p.ProductName ORDER BY InventoryTurnoverRatio DESC",

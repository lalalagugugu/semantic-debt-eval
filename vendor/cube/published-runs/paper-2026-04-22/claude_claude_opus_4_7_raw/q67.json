  "sql": "SELECT p.ColorName AS ColorName, sum(o.SalesAmount)/sum(o.SalesQuantity) AS AvgUnitPriceRealized, sum(o.SalesQuantity) AS TotalUnits FROM retail.FactOnlineSales o INNER JOIN retail.DimProduct p ON o.ProductKey = p.ProductKey WHERE p.ColorName IS NOT NULL GROUP BY p.ColorName HAVING TotalUnits >= 1000 ORDER BY AvgUnitPriceRealized DESC",

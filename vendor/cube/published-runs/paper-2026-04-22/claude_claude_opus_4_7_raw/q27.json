  "sql": "SELECT p.ProductName, sum(f.SalesAmount) AS SalesAmount, sum(f.TotalCost) AS TotalCost, (sum(f.SalesAmount) - sum(f.TotalCost)) / sum(f.SalesAmount) * 100 AS ProfitMarginPct FROM retail.FactSales AS f INNER JOIN retail.DimProduct AS p ON f.ProductKey = p.ProductKey GROUP BY p.ProductName HAVING sum(f.SalesAmount) > 0 ORDER BY ProfitMarginPct DESC LIMIT 10",

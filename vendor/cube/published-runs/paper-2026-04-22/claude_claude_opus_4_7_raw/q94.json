  "variant": "raw",
  "sql": "SELECT\n    s.StoreName AS StoreName,\n    sumIf(f.SalesAmount, toQuarter(f.DateKey) = 3) AS Q3Sales,\n    sumIf(f.SalesAmount, toQuarter(f.DateKey) = 4) AS Q4Sales,\n    Q4Sales - Q3Sales AS Diff,\n    if(Q3Sales = 0, NULL, (Q4Sales - Q3Sales) / Q3Sales * 100) AS PctChange\nFROM retail.FactSales AS f\nINNER JOIN retail.DimStore AS s ON s.StoreKey = f.StoreKey\nWHERE toYear(f.DateKey) = 2009 AND toQuarter(f.DateKey) IN (3, 4)\nGROUP BY s.StoreName\nHAVING Q3Sales > 0 AND Q4Sales < Q3Sales\nORDER BY PctChange ASC;",

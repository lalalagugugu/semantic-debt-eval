  "sql": "SELECT\n  c.Occupation AS CustomerSegment,\n  sum(f.SalesAmount) - sum(f.TotalCost) AS GrossMargin,\n  sum(f.SalesAmount) AS SalesAmount,\n  (sum(f.SalesAmount) - sum(f.TotalCost)) / nullif(sum(f.SalesAmount), 0) AS GrossMarginPct\nFROM retail.FactOnlineSales f\nJOIN retail.DimCustomer c ON f.CustomerKey = c.CustomerKey\nGROUP BY CustomerSegment\nORDER BY GrossMargin DESC",

  "sql": "SELECT m.EmployeeKey AS ManagerKey,\n       concat(m.FirstName, ' ', m.LastName) AS ManagerName,\n       count(*) AS DirectReports,\n       avg(dateDiff('day', toDate(e.HireDate), toDate('2009-12-31')) / 365.0) AS AvgTenureYears\nFROM retail.DimEmployee e\nJOIN retail.DimEmployee m ON e.ParentEmployeeKey = m.EmployeeKey\nWHERE e.HireDate IS NOT NULL\nGROUP BY m.EmployeeKey, ManagerName\nORDER BY DirectReports DESC",

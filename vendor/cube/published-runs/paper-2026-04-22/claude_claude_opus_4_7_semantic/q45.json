  "sql": "SELECT s.StoreKey, s.StoreName, s.SellingAreaSize, sum(f.SalesAmount) AS total_sales, sum(f.SalesAmount) / nullif(s.SellingAreaSize, 0) AS sales_per_sqft\nFROM retail.FactSales f\nJOIN retail.DimStore s ON f.StoreKey = s.StoreKey\nWHERE s.SellingAreaSize > 0\nGROUP BY s.StoreKey, s.StoreName, s.SellingAreaSize\nORDER BY sales_per_sqft DESC",

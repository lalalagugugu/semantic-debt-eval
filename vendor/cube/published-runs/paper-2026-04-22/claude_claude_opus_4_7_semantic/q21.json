  "sql": "SELECT i.StoreKey AS StoreKey, s.StoreName AS StoreName, i.ProductKey AS ProductKey, p.ProductName AS ProductName, i.OnHandQuantity AS OnHandQuantity\nFROM retail.FactInventory i\nINNER JOIN (\n  SELECT StoreKey, ProductKey, MAX(DateKey) AS max_date\n  FROM retail.FactInventory\n  GROUP BY StoreKey, ProductKey\n) latest ON i.StoreKey = latest.StoreKey AND i.ProductKey = latest.ProductKey AND i.DateKey = latest.max_date\nLEFT JOIN retail.DimStore s ON i.StoreKey = s.StoreKey\nLEFT JOIN retail.DimProduct p ON i.ProductKey = p.ProductKey\nORDER BY StoreName, ProductName",

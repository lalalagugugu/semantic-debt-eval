  "sql": "SELECT p.BrandName AS BrandName, sum(f.SalesAmount) AS TotalRevenue, sum(f.SalesQuantity) AS UnitsSold\nFROM retail.FactOnlineSales f\nINNER JOIN retail.DimProduct p ON f.ProductKey = p.ProductKey\nWHERE toYear(f.DateKey) = 2008\nGROUP BY p.BrandName\nHAVING sum(f.SalesQuantity) >= 500\nORDER BY TotalRevenue DESC",

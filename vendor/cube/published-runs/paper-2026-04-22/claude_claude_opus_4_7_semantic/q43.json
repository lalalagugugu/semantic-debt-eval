  "sql": "SELECT g.RegionCountryName AS Region,\n       sum(f.SalesAmount) - sum(f.TotalCost) AS GrossMargin\nFROM retail.FactOnlineSales f\nJOIN retail.DimCustomer c ON f.CustomerKey = c.CustomerKey\nJOIN retail.DimGeography g ON c.GeographyKey = g.GeographyKey\nGROUP BY g.RegionCountryName\nORDER BY GrossMargin DESC",

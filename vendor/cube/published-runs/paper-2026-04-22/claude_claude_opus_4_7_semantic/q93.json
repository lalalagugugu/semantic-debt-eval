  "sql": "SELECT p.PromotionName, p.PromotionCategory, p.DiscountPercent, sum(f.SalesQuantity) AS units_sold, countDistinct(f.SalesOrderNumber) AS orders, sum(f.SalesAmount) AS sales_amount, sum(f.DiscountAmount) AS discount_amount, sum(f.SalesQuantity) / nullif(countDistinct(f.SalesOrderNumber), 0) AS units_per_order FROM retail.FactOnlineSales f JOIN retail.DimPromotion p ON f.PromotionKey = p.PromotionKey WHERE f.PromotionKey <> 1 GROUP BY p.PromotionName, p.PromotionCategory, p.DiscountPercent ORDER BY p.DiscountPercent",

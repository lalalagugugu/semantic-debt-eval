  "sql": "SELECT\n  CustomerKey,\n  CASE\n    WHEN months_since_last <= 6 THEN 'Active'\n    WHEN months_since_last <= 12 THEN 'At Risk'\n    ELSE 'Churned'\n  END AS RecencySegment,\n  months_since_last AS MonthsSinceLastPurchase\nFROM (\n  SELECT\n    CustomerKey,\n    dateDiff('month', MAX(DateKey), toDate('2009-12-31')) AS months_since_last\n  FROM retail.FactOnlineSales\n  GROUP BY CustomerKey\n)",

{
  "question_id": 34,
  "model": "claude-opus-4-7",
  "variant": "semantic",
  "sql": "SELECT\n  p.ProductKey AS ProductKey,\n  p.ProductName AS ProductName,\n  sum(s.TotalCost) AS COGS,\n  avg(i.OnHandQuantity * p.UnitCost) AS AvgInventoryValue,\n  sum(s.TotalCost) / nullif(avg(i.OnHandQuantity * p.UnitCost), 0) AS InventoryTurnover\nFROM retail.DimProduct p\nLEFT JOIN (\n  SELECT ProductKey, sum(TotalCost) AS TotalCost\n  FROM retail.FactSales\n  WHERE toYear(DateKey) = 2009\n  GROUP BY ProductKey\n) s ON s.ProductKey = p.ProductKey\nLEFT JOIN (\n  SELECT ProductKey, avg(OnHandQuantity * UnitCost) AS AvgInv\n  FROM retail.FactInventory\n  WHERE toYear(DateKey) = 2009\n  GROUP BY ProductKey\n) inv ON inv.ProductKey = p.ProductKey\nLEFT JOIN retail.FactInventory i ON i.ProductKey = p.ProductKey AND toYear(i.DateKey) = 2009\nGROUP BY p.ProductKey, p.ProductName\nORDER BY InventoryTurnover DESC",

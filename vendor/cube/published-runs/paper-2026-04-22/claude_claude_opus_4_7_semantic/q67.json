  "sql": "SELECT p.ColorName AS ColorName, sum(f.SalesAmount)/nullif(sum(f.SalesQuantity),0) AS AvgRealizedUnitPrice, sum(f.SalesQuantity) AS TotalUnits\nFROM retail.FactOnlineSales f\nINNER JOIN retail.DimProduct p ON f.ProductKey = p.ProductKey\nGROUP BY p.ColorName\nHAVING sum(f.SalesQuantity) >= 1000\nORDER BY AvgRealizedUnitPrice DESC",

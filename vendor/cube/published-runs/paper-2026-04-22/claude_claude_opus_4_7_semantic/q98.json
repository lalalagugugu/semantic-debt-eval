  "variant": "semantic",
  "sql": "SELECT pc.ProductCategoryName AS category,\n       toYear(f.DateKey) AS year,\n       sumIf(f.SalesAmount, toQuarter(f.DateKey) = 1) AS q1_sales,\n       sumIf(f.SalesAmount, toQuarter(f.DateKey) = 2) AS q2_sales,\n       sumIf(f.SalesAmount, toQuarter(f.DateKey) = 3) AS q3_sales,\n       sumIf(f.SalesAmount, toQuarter(f.DateKey) = 4) AS q4_sales,\n       sum(f.SalesAmount) AS annual_sales,\n       greatest(sumIf(f.SalesAmount, toQuarter(f.DateKey) = 1),\n                sumIf(f.SalesAmount, toQuarter(f.DateKey) = 2),\n                sumIf(f.SalesAmount, toQuarter(f.DateKey) = 3),\n                sumIf(f.SalesAmount, toQuarter(f.DateKey) = 4)) AS peak_quarter_sales,\n       peak_quarter_sales * 100.0 / nullif(sum(f.SalesAmount), 0) AS peak_quarter_share_pct\nFROM retail.FactOnlineSales f\nJOIN retail.DimProduct p ON f.ProductKey = p.ProductKey\nJOIN retail.DimProductSubcategory ps ON p.ProductSubcategoryKey = ps.ProductSubcategoryKey\nJOIN retail.DimProductCategory pc ON ps.ProductCategoryKey = pc.ProductCategoryKey\nGROUP BY pc.ProductCategoryName, year\nORDER BY peak_quarter_share_pct DESC",

  "sql": "SELECT StoreKey, StoreName, ProductKey, ProductName, product_sales, store_total, product_sales * 100.0 / nullif(store_total, 0) AS share_pct, rn\nFROM (\n  SELECT\n    s.StoreKey AS StoreKey,\n    st.StoreName AS StoreName,\n    s.ProductKey AS ProductKey,\n    p.ProductName AS ProductName,\n    sum(s.SalesAmount) AS product_sales,\n    sum(sum(s.SalesAmount)) OVER (PARTITION BY s.StoreKey) AS store_total,\n    row_number() OVER (PARTITION BY s.StoreKey ORDER BY sum(s.SalesAmount) DESC) AS rn\n  FROM retail.FactOnlineSales s\n  JOIN retail.DimStore st ON st.StoreKey = s.StoreKey\n  JOIN retail.DimProduct p ON p.ProductKey = s.ProductKey\n  WHERE toYear(s.DateKey) = 2009\n  GROUP BY s.StoreKey, st.StoreName, s.ProductKey, p.ProductName\n)\nWHERE rn <= 3\nORDER BY StoreKey, rn",

  "variant": "semantic",
  "sql": "WITH per_customer AS (\n  SELECT\n    CustomerKey,\n    countDistinct(SalesOrderNumber) AS order_count,\n    sum(SalesAmount) / nullif(countDistinct(SalesOrderNumber), 0) AS avg_order_value,\n    sum(SalesAmount) AS total_sales\n  FROM retail.FactOnlineSales\n  GROUP BY CustomerKey\n),\nthresholds AS (\n  SELECT\n    quantile(0.9)(order_count) AS order_count_p90,\n    quantile(0.9)(avg_order_value) AS aov_p90\n  FROM per_customer\n)\nSELECT\n  p.CustomerKey,\n  c.FirstName,\n  c.LastName,\n  p.order_count,\n  p.avg_order_value,\n  p.total_sales\nFROM per_customer p\nCROSS JOIN thresholds t\nLEFT JOIN retail.DimCustomer c ON c.CustomerKey = p.CustomerKey\nWHERE p.order_count >= t.order_count_p90\n  AND p.avg_order_value >= t.aov_p90\nORDER BY p.total_sales DESC",

  "sql": "SELECT s.StoreKey, s.StoreName,\n       sum(fs.SalesAmount) AS actual_sales,\n       sum(fq.SalesAmountQuota) AS quota,\n       sum(fs.SalesAmount) / nullif(sum(fq.SalesAmountQuota), 0) * 100.0 AS attainment_pct\nFROM retail.DimStore s\nJOIN (\n    SELECT StoreKey, sum(SalesAmount) AS SalesAmount\n    FROM retail.FactSales\n    WHERE toYear(DateKey) = 2009\n    GROUP BY StoreKey\n) fs ON fs.StoreKey = s.StoreKey\nJOIN (\n    SELECT StoreKey, sum(SalesAmountQuota) AS SalesAmountQuota\n    FROM retail.FactSalesQuota\n    WHERE toYear(DateKey) = 2009\n    GROUP BY StoreKey\n) fq ON fq.StoreKey = s.StoreKey\nGROUP BY s.StoreKey, s.StoreName, fs.SalesAmount, fq.SalesAmountQuota\nORDER BY attainment_pct DESC\nLIMIT 10",

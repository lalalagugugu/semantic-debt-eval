{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private evaluation question set",
  "type": "object",
  "required": [
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "text_en",
          "text_zh",
          "type",
          "refs",
          "scoring",
          "scoring_notes",
          "labels",
          "split",
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]{2,}$"
          },
          "source": {
            "enum": [
              "cube",
              "new"
            ]
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "text_zh": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "指标分析",
              "维度查找",
              "统计",
              "开放式"
            ]
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "interpretation",
                "sql",
                "result_path"
              ],
              "additionalProperties": false,
              "properties": {
                "interpretation": {
                  "type": "string",
                  "minLength": 1
                },
                "sql": {
                  "type": "string",
                  "minLength": 1
                },
                "result_path": {
                  "type": "string",
                  "pattern": "^refs/[A-Za-z0-9/_-]+\\.csv$"
                },
                "postprocess": {
                  "description": "Explicit approved processing of a SQL aggregate domain using the shared Decimal quantization policy; omitted for direct SQL results.",
                  "enum": [
                    "abc_groups",
                    "abc_groups_after",
                    "power_customers",
                    "store_top3",
                    "selection",
                    "baseline_top_decile",
                    "product_rank_competition",
                    "product_rank_dense"
                  ]
                },
                "rules": {
                  "$ref": "#/$defs/rulesOverride"
                }
              }
            }
          },
          "scoring": {
            "enum": [
              "deterministic",
              "judge"
            ]
          },
          "scoring_notes": {
            "type": "string"
          },
          "labels": {
            "type": "object"
          },
          "rules": {
            "type": "object",
            "required": [
              "ordered",
              "top_n",
              "tie_columns",
              "value_kinds",
              "value_types"
            ],
            "additionalProperties": false,
            "properties": {
              "ordered": {
                "type": "boolean"
              },
              "top_n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "tie_columns": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "value_kinds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "percentage",
                    "ratio",
                    "amount",
                    "count",
                    "other"
                  ]
                }
              },
              "value_types": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "selection": {
                "$ref": "#/$defs/selection"
              },
              "order_by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/orderKey"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "ordered": {
                      "const": true
                    }
                  },
                  "required": [
                    "ordered"
                  ]
                },
                "then": {
                  "required": [
                    "order_by"
                  ]
                }
              }
            ]
          },
          "split": {
            "enum": [
              null,
              "tuning",
              "heldout"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "rulesOverride": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ordered": {
          "type": "boolean"
        },
        "top_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "tie_columns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "value_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "percentage",
              "ratio",
              "amount",
              "count",
              "other"
            ]
          }
        },
        "value_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "order_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/orderKey"
          }
        }
      },
      "required": [
        "ordered",
        "top_n",
        "tie_columns",
        "value_kinds",
        "value_types"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ordered": {
                "const": true
              }
            },
            "required": [
              "ordered"
            ]
          },
          "then": {
            "required": [
              "order_by"
            ]
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "stages",
        "output_order"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "where",
              "group_columns",
              "object_columns",
              "order_by",
              "n"
            ],
            "properties": {
              "parent": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "where": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "column",
                    "equals"
                  ],
                  "properties": {
                    "column": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "equals": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              },
              "group_columns": {
                "$ref": "#/$defs/columns"
              },
              "object_columns": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "order_by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/orderKey"
                }
              },
              "n": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "output_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orderKey"
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "orderKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "descending"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "descending": {
          "type": "boolean"
        }
      }
    }
  }
}

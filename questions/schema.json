{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private evaluation question set",
  "type": "object",
  "required": [
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "text_en",
          "text_zh",
          "type",
          "refs",
          "scoring",
          "scoring_notes",
          "labels",
          "split"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]{2,}$"
          },
          "source": {
            "enum": [
              "cube",
              "new"
            ]
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "text_zh": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "指标分析",
              "维度查找",
              "统计",
              "开放式"
            ]
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "interpretation",
                "sql",
                "result_path"
              ],
              "additionalProperties": false,
              "properties": {
                "interpretation": {
                  "type": "string",
                  "minLength": 1
                },
                "sql": {
                  "type": "string",
                  "minLength": 1
                },
                "result_path": {
                  "type": "string",
                  "pattern": "^refs/[A-Za-z0-9/_-]+\\.csv$"
                },
                "postprocess": {
                  "description": "Explicit approved processing of a SQL aggregate domain using the shared Decimal quantization policy; omitted for direct SQL results.",
                  "enum": ["abc_groups", "power_customers", "store_top3"]
                }
              }
            }
          },
          "scoring": {
            "enum": [
              "deterministic",
              "judge"
            ]
          },
          "scoring_notes": {
            "type": "string"
          },
          "labels": {
            "type": "object"
          },
          "split": {
            "enum": [
              null,
              "tuning",
              "heldout"
            ]
          }
        }
      }
    }
  }
}
